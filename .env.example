# RSS aggregator environment example

# Network/server
RSS_AGG_HOST=127.0.0.1
RSS_AGG_PORT=18090
RSS_AGG_CACHE_TTL=300
RSS_AGG_TIMEOUT=20
RSS_AGG_MAX_ITEMS=1000
RSS_AGG_FEEDS_FILE=rss_feeds.json
RSS_AGG_OUTPUT_FILE=feed.rss

# Feed metadata
RSS_AGG_CHANNEL_TITLE=BioluxeLab_Aggregated_Feed
RSS_AGG_CHANNEL_LINK=https://bioluxelab.com/
RSS_AGG_CHANNEL_DESCRIPTION=Aggregated_RSS_feeds_for_BioluxeLab
RSS_AGG_USER_AGENT=RSSAggregator/1.0 (+https://localhost)

# Shopify Admin source support (optional)
RSS_AGG_SHOPIFY_DOMAIN=
RSS_AGG_SHOPIFY_API_VERSION=2026-01
RSS_AGG_SHOPIFY_ADMIN_TOKEN=
RSS_AGG_SHOPIFY_CLIENT_ID=
RSS_AGG_SHOPIFY_CLIENT_SECRET=

# Logging
RSS_AGG_LOG_FILE=logs/rss_aggregator.log
RSS_AGG_LOG_LEVEL=INFO
RSS_AGG_LOG_MAX_BYTES=5242880
RSS_AGG_LOG_BACKUP_COUNT=5
